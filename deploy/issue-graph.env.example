# issue-graph.env — секреты/настройки прод-контейнера issue-graph.
# Скопируй в issue-graph.env и заполни. НЕ коммить (в .gitignore).
# На сервере держи файл root:root 600 (там пароль админки) — compose читается под sudo.

# Пароль админки (#admin). Длинный случайный.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Публичный адрес приложения (как открывают в браузере). Сюда GitLab вернёт после OAuth.
OAUTH_REDIRECT_BASE=https://graf.fakspro.ru
FRONTEND_URL=https://graf.fakspro.ru

# Разрешённые origin (один origin за traefik — тот же адрес).
CORS_ORIGINS=https://graf.fakspro.ru
