# cp to gitlab-notify.env on the server. Connections (Matrix/webhook/GitLab) and
# the groups are configured in the admin panel (/admin) and stored in the DB —
# NOT here. On first run the bot boots UNCONFIGURED: open /admin and set them.
# Only the admin password + infra knobs live in this file.

# REQUIRED — admin panel password (the one bootstrap secret). The panel can
# message the whole team, so keep the port off the public net (BIND_ADDR +
# reverse proxy / SSH tunnel).
ADMIN_PASSWORD=change-me-long-random
BIND_ADDR=127.0.0.1

# The bot schedules its own digests (per-pass days+time in /admin), so no host
# cron is needed. false -> boot quietly / drive cron.py from host cron instead.
SCHEDULER_ENABLED=true

# Timezone the scheduler uses for digest times (container is UTC by default).
TZ=Europe/Moscow
STATE_DB=/data/state.db
LOG_LEVEL=INFO

# Digest schedule seeds (admin panel overrides without a restart):
DIGEST_ANCHOR_DAYS=wed,fri        # full personal/team overview on these days
DIGEST_WEEKLY_DAY=mon             # triage/stale hygiene digest day
STALE_DAYS=14                     # "no activity for N days" threshold

# --- Optional one-time seed (copied into the DB on first boot, then ignored) -
# Leave out to configure everything in /admin.
# MATRIX_HOMESERVER=https://matrix.fakspro.ru
# MATRIX_TOKEN=syt_...
# WEBHOOK_SECRET=change-me-long-random
# GITLAB_URL=https://git.fakspro.ru
# GITLAB_GROUP_ID=3      GITLAB_TOKEN=glpat-...(read_api)      MATRIX_ROOM=!yourroomid
