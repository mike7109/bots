# cp to gitlab-notify.env on the server. Secrets only (rest is in config.yaml).
MATRIX_HOMESERVER=https://matrix.fakspro.ru
MATRIX_TOKEN=syt_...bot_access_token...
MATRIX_ROOM=!yourroomid                   # shared room id (no :fakspro.ru); overrides config.yaml
WEBHOOK_SECRET=change-me-long-random
GITLAB_URL=https://git.fakspro.ru
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_GROUP_ID=3
LOG_LEVEL=INFO

# Timezone the scheduler uses for digest times (container is UTC by default).
TZ=Europe/Moscow

# Web admin panel at /admin. Unset -> panel disabled. Set a long random secret;
# the panel can message the whole team, so keep the port off the public net
# (127.0.0.1 + reverse proxy / SSH tunnel).
ADMIN_PASSWORD=change-me-long-random

# Runtime settings live in the state DB (admin panel overrides these defaults).
STATE_DB=/data/state.db
# The bot schedules its own digests (per-pass days+time set in the admin panel),
# so no host cron is needed. Set to false to drive cron.py from host cron instead.
SCHEDULER_ENABLED=true
# Initial schedule seed (admin panel overrides without a restart):
DIGEST_ANCHOR_DAYS=wed,fri        # full personal/team overview on these days
DIGEST_WEEKLY_DAY=mon             # triage/stale hygiene digest day
DIGEST_HOLIDAYS=                  # extra silent dates, ISO, comma-separated
STALE_DAYS=14                     # "no activity for N days" threshold
