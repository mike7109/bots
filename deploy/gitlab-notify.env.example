# cp to gitlab-notify.env on the server. Everything substantive (Matrix/webhook/
# GitLab connections, groups, schedules, scheduler on/off, holidays, stale
# threshold) is configured in the admin panel (/admin) and stored in the DB —
# NOT here. This file holds only the bootstrap password + infra knobs. On first
# run the bot boots UNCONFIGURED: open /admin and set it.

# REQUIRED — admin panel password (the one bootstrap secret). The panel can
# message the whole team, so keep the port off the public net (BIND_ADDR +
# reverse proxy / SSH tunnel).
ADMIN_PASSWORD=change-me-long-random

# Infra knobs (startup / docker-compose; not app config):
BIND_ADDR=127.0.0.1                # docker-compose port mapping (+ admin reachability)
STATE_DB=/data/state.db
TZ=Europe/Moscow                   # container clock — scheduler fires in this tz
LOG_LEVEL=INFO

# --- Optional one-time seed (copied into the DB on first boot, then ignored) -
# Leave out to configure everything in /admin.
# MATRIX_HOMESERVER=https://matrix.fakspro.ru
# MATRIX_TOKEN=syt_...
# WEBHOOK_SECRET=change-me-long-random
# GITLAB_URL=https://git.fakspro.ru
# GITLAB_GROUP_ID=3      GITLAB_TOKEN=glpat-...(read_api)      MATRIX_ROOM=!yourroomid
