# Скопируй в .env и заполни (для прод-развёртывания через docker-compose.yml).

# Владелец GHCR (github username/org), откуда тянуть образ:
GHCR_OWNER=your-github-username

# Пароль админки (#admin) — придумай длинный случайный.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Публичный URL приложения (как его видит пользователь в браузере).
# Именно сюда GitLab вернёт после OAuth. Для HTTPS — https://...
PUBLIC_URL=https://issuegraph.example.com

# Куда биндить порт на хосте. За reverse-proxy оставь 127.0.0.1.
# Для прямого доступа без прокси: 0.0.0.0:8000
BIND=127.0.0.1:8000

# ── опционально ──
# Можно заранее задать GitLab host (иначе укажешь в админке #admin):
# GITLAB_URL=https://gitlab.example.com
# GITLAB_CONCURRENCY=12
# CACHE_TTL=60
