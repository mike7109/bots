{# The full task CARD — the FIRST message inside a watched issue's thread (nested
   under the issue_root anchor). Posted once, together with the anchor, when the
   topic is first created (eagerly on open, or lazily on a later comment / label
   add). Labelled fields, plain-text assignee (info, not a ping). #}
{% if description %}📝 <b>Описание</b><br>{{ clip_comment(description, url) }}<br>{% else %}📝 <i>Без описания</i>{% endif %}
{% set shown = display_labels(labels) %}
{% if assignees %}<br>👤 <b>Исполнитель:</b> {{ names(assignees) }}{% endif %}
{% if due %}<br>📅 <b>Срок:</b> {{ due | ru_date }}{% endif %}
{% if shown %}<br>🏷 <b>Метки:</b> {{ shown | join(', ') }}{% endif %}
