# Copy to .env. Almost everything is now configured in the admin panel (/admin)
# and stored in the DB — Matrix connection, webhook secret, GitLab URL, and the
# groups (group -> room + token). On first run the bot boots UNCONFIGURED: open
# /admin and set them. Only the admin password + infra knobs live here.

# REQUIRED — password for the admin panel (the one bootstrap secret; without it
# the panel is disabled and you can't configure anything).
ADMIN_PASSWORD=change-me-long-random

# Where to expose the bot + admin. 127.0.0.1 (+ SSH tunnel), or a LAN ip.
BIND_ADDR=127.0.0.1

# The bot schedules its own digests (per-pass days+time in /admin). Start false
# to boot quietly; turn on in /admin or here when ready.
SCHEDULER_ENABLED=false

TZ=Europe/Moscow
STATE_DB=/data/state.db                   # runtime state on the mounted volume
LOG_LEVEL=INFO

# Digest schedule seeds (admin overrides them without a restart):
DIGEST_ANCHOR_DAYS=wed,fri                 # full personal/team overview these days
DIGEST_WEEKLY_DAY=mon                      # triage/stale hygiene day
STALE_DAYS=14

# --- Optional one-time seed -------------------------------------------------
# If present on the FIRST boot only, these are copied into the DB once and then
# ignored (the admin panel is authoritative afterwards). Leave them out to set
# everything in /admin instead.
# MATRIX_HOMESERVER=https://matrix.fakspro.ru
# MATRIX_TOKEN=syt_...bot_access_token...
# WEBHOOK_SECRET=change-me-long-random
# GITLAB_URL=https://git.fakspro.ru
# GITLAB_GROUP_ID=3        # + GITLAB_TOKEN + MATRIX_ROOM -> seeds the first group
# GITLAB_TOKEN=glpat-...   # scope: read_api
# MATRIX_ROOM=!yourroomid
