# Copy to .env. Secrets only — everything else is in config.yaml.

# Matrix (the @gitlab-bot account; reuse the existing token)
MATRIX_HOMESERVER=https://matrix.fakspro.ru
MATRIX_TOKEN=syt_...bot_access_token...
MATRIX_ROOM=!yourroomid                   # shared room id (no :fakspro.ru); overrides config.yaml

# GitLab webhook secret (must equal the webhook's "Secret token")
WEBHOOK_SECRET=change-me-long-random

# GitLab API (used by cron.py for due-date reminders / task polling)
GITLAB_URL=https://git.fakspro.ru
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx   # scope: api (read is enough)
GITLAB_GROUP_ID=3                         # FAKSPRO group

LOG_LEVEL=INFO

# --- new in this version ---------------------------------------------------
# Where to expose the bot (and admin panel). Keep 127.0.0.1 + SSH tunnel, or set
# a LAN ip to reach /admin from the office network (still password-gated).
BIND_ADDR=127.0.0.1

# Web admin panel at /admin. Unset -> panel disabled (bot still runs webhooks).
# Set a long random secret; it can message the whole team.
ADMIN_PASSWORD=

# The bot schedules its own digests (per-pass days+time in /admin). Start with
# false to deploy quietly (webhooks still fire), flip to true when ready.
SCHEDULER_ENABLED=false

TZ=Europe/Moscow
STATE_DB=/data/state.db                   # runtime state on the mounted volume
