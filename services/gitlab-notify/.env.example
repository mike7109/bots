# Copy to .env. Everything substantive is configured in the admin panel (/admin)
# and stored in the DB — Matrix connection, webhook secret, GitLab URL, groups,
# schedules, mutes, the scheduler on/off toggle, holidays, the stale threshold.
# This file holds ONLY the bootstrap password + a few infra knobs that can't
# live in the DB. On first run the bot boots UNCONFIGURED: open /admin and set it.

# REQUIRED — password for the admin panel (the one bootstrap secret; without it
# the panel is disabled and nothing can be configured).
ADMIN_PASSWORD=change-me-long-random

# Infra knobs (read at startup / by docker-compose; not app config):
BIND_ADDR=127.0.0.1                # docker-compose port mapping (+ admin reachability)
STATE_DB=/data/state.db            # where the SQLite state lives
TZ=Europe/Moscow                   # container clock — scheduler fires in this tz
LOG_LEVEL=INFO

# --- Optional one-time seed -------------------------------------------------
# If present on the FIRST boot only, these are copied into the DB once and then
# ignored. Leave them out to set everything in /admin.
# MATRIX_HOMESERVER=https://matrix.fakspro.ru
# MATRIX_TOKEN=syt_...
# WEBHOOK_SECRET=change-me-long-random
# GITLAB_URL=https://git.fakspro.ru
# GITLAB_GROUP_ID=3        GITLAB_TOKEN=glpat-...(read_api)        MATRIX_ROOM=!yourroomid
